# Runtime data — never commit the database or participant responses in raw form
data/app.sqlite
data/app.sqlite-*
data/*.db

# Stimulus images are added per-deployment; keep the folder, not the contents
data/images/*
!data/images/.gitkeep

# Precomputed model runs are regenerable; exports are NOT and are committed
data/model/*
!data/model/.gitkeep

# Model artifacts
*_merged/
*.safetensors
eval_output/

# Python
__pycache__/
*.pyc
.venv/
.venv-model/
venv/

# OS
.DS_Store
Thumbs.db
