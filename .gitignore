# Runtime data — never commit the database or participant responses in raw form
data/app.sqlite
data/app.sqlite-*
data/*.db


# Model runs ARE committed. The original rule assumed they were regenerable,
# which was true only while they were synthetic placeholders: a real run is
# an hour or more of MPS time against weights this Codespace does not have,
# so the JSON is the only artifact of that compute and the container is
# eventually deleted with everything in it. Each file says which it is in its
# "source" field, and the server warns loudly at startup about synthetic ones.
!data/model/.gitkeep
!data/model/*.json

# Model artifacts
*_merged/
*.safetensors
eval_output/

# Python
__pycache__/
*.pyc
.venv/
.venv-model/
venv/

# OS
.DS_Store
Thumbs.db

# Dev server helper artifacts. Globbed, not named: devserver.sh writes one
# pid file and one log per port, so the old fixed names stopped matching the
# moment the script learned to move ports — and `git add -A` swept four logs
# into the repository before anyone noticed.
.devserver*.pid
.devserver*.log
